# Generated development-only MinIO credentials. Change all four after copying
# this file to .env; never reuse these committed values outside local development.
MINIO_ROOT_USER=gridgo_root_4e39b7a1
MINIO_ROOT_PASSWORD=ggo_root_86c7e0a5d9124fb3
MINIO_ACCESS_KEY=gridgo_api_7f3a91c2
MINIO_SECRET_KEY=ggo_api_m1n10_9f41b7c3e68a2d55

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Safe default: both MinIO ports are host-loopback only. For a physical phone,
# opt in by setting MINIO_BIND_ADDRESS to this machine's exact LAN IPv4 (never
# 0.0.0.0), then set MINIO_PUBLIC_URL to the same origin. This exposes the
# private bucket's signed-GET data plane to that LAN and must not be used on an
# untrusted network. The console always remains on 127.0.0.1.
MINIO_BIND_ADDRESS=127.0.0.1

# Internal API-to-MinIO origin. MINIO_PUBLIC_URL is the exact origin embedded
# in signed URLs; rewriting a signed URL afterward invalidates the signature.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_BUCKET=gridgo-uploads
MINIO_REGION=us-east-1
MINIO_DOWNLOAD_URL_TTL_SECONDS=300
UPLOAD_REQUEST_TIMEOUT_MS=900000

# PostgreSQL 17 domain database. Local compose publishes the database on this
# loopback-only high port for migrations, seeds, tests and host-run API work.
# Production uses the private `postgres` container name and never publishes a
# host port. POSTGRES_PASSWORD is a template value only; replace it outside dev.
POSTGRES_DB=gridgo
POSTGRES_USER=gridgo
POSTGRES_PASSWORD=gridgo_dev
POSTGRES_PORT=55439
DATABASE_URL=postgresql://gridgo:gridgo_dev@127.0.0.1:55439/gridgo
# Optional pool tuning; defaults are 10 connections and a 5-second connect timeout.
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_IDLE_TIMEOUT_MS=30000

# Firebase Cloud Messaging (phone push). Optional: with no path set, the API
# runs normally and only in-app/SSE notifications are delivered, and /health
# reports push.status "disabled". Point this at the Firebase service-account
# JSON on disk; never copy that file into this repository. The hosted pilot
# installs it as a mode-0600 secret file — see docs/DEPLOYMENT.md §2.
# GRIDGO_FCM_SERVICE_ACCOUNT_FILE=/absolute/path/to/fcm-service-account.json

# Phone-visible origin of this API, used to turn hosted broadcast pictures
# into lock-screen image URLs the handset can download. Locally, an http
# MINIO_PUBLIC_URL is enough (same host, this process's port). Production
# must set the public API origin explicitly.
# GRIDGO_PUBLIC_API_ORIGIN=https://gridgo-api.talasora.com

# Test/staging override for the FCM v1 host. Leave unset in every real
# deployment; it exists so the test suite can point at a local fake.
# GRIDGO_FCM_BASE_URL=https://fcm.googleapis.com

# Clerk is the only authentication path. All three values are mandatory; the
# API refuses startup when one is missing. Never commit the real secret key.
CLERK_SECRET_KEY=
CLERK_ISSUER=https://<dev>.clerk.accounts.dev
# Include the Clerk frontend origin and every Expo/web origin that will
# appear in the session JWT azp claim. Replace `<dev>` before starting.
CLERK_AUTHORIZED_PARTIES=https://<dev>.clerk.accounts.dev,http://localhost:8081,http://localhost:19006,http://localhost:5173
# Optional PEM for networkless JWT verification. Tests set this; a local
# process can omit it and use the instance JWKS instead.
# CLERK_JWT_KEY=
# Test-only override for the Clerk Backend API origin. Leave unset locally
# and in every real deployment.
# CLERK_API_URL=https://api.clerk.com

# Browser clients require an exact allowlist. Originless mobile/curl requests
# still work when this is empty, but browser requests will be rejected.
# Local: dashboard :3000 plus Expo web for client/supplier/rider :8081/:8082/:8083.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:8083,http://127.0.0.1:8083
# Hosted pilot value: CORS_ALLOWED_ORIGINS=https://gridgo-dash.talasora.com
# Landing /support also needs the exact public site origin, for example
# https://gridgo.talasora.com, or the browser POST is origin_not_allowed.

# Public support-ticket desk (landing /support). Mail is optional: replies
# still save when EMAIL_* is unset, and /health reports emailConfigured.
# Desk login hashes SUPPORT_DESK_PASSWORD into support_admins at boot and
# checks the database hash, never the env value. SUPPORT_DESK_JWT_SECRET is
# independent of Clerk.
# EMAIL_USER=
# EMAIL_PASSWORD=
# SUPPORT_DESK_USERNAME=
# SUPPORT_DESK_PASSWORD=
# SUPPORT_DESK_JWT_SECRET=

# Hosted pilot: see docs/DEPLOYMENT.md. Production uses a private PostgreSQL URL,
# production Clerk instance values, explicit MinIO config and HTTPS public URLs.
