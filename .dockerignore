# Keep the build context to what the API actually runs.
# Anything left in here is uploaded to the daemon on every build and, worse, can
# be copied into an image layer by accident.

.git
.github
node_modules

# The local development store. It contains the committed demo password, demo
# accounts and rich demo orders — production startup refuses a store carrying
# those records, and an image is the last place that file should ever travel in.
data

# Secrets. `.env.example` carries only the generated local-development values and
# is documentation, but nothing in the image reads any env file: the deployment
# supplies environment variables from files that live on the server.
.env
.env.*
!.env.example

*.pem

npm-debug.log*
yarn-debug.log*

.DS_Store
.vscode
.idea

# Agent/tooling material and documentation with no bearing on the running API.
.agents
.claude
.lavish
.tmp
tests
docs
deploy
docker
docker-compose.yml
Dockerfile
.dockerignore
AGENTS.md
CLAUDE.md
PRD.md
README.md
